variable {e : ℕ} {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]

theorem pullback_add_ofFun (μ : Y → X) (hμ : Continuous μ) (P : LocPot X) (w : X → ℝ) :
    (P + LocPot.ofFun w).pullback μ hμ = P.pullback μ hμ + LocPot.ofFun (fun y => w (μ y)) := rfl

end

