namespace UpperTheory.Gal.G3

theorem splitsPts_holds : SplitsPts := pSplitsPts _root_.UpperTheory.Gal.G3.pIsoPts

theorem fEtBasic_holds : FEtBasic := pFEtBasic _root_.UpperTheory.Gal.G3.pPtsOfSplits

theorem splitsBasic_holds : SplitsBasic := pSplitsBasic splitsPts_holds _root_.UpperTheory.Gal.G3.pPtsOfSplits

theorem splitsComp_holds : SplitsComp := pSplitsComp splitsPts_holds _root_.UpperTheory.Gal.G3.pPtsOfSplits

theorem bcSplits_holds : BcSplits := @pBcSplits @splitsBasic_holds

theorem bcGal_holds : BcGal := pBcGal bcSplits_holds

theorem ordEx_holds : OrdEx := pOrdEx _root_.UpperTheory.Gal.G3.pOrdStep

theorem galClosD_holds : GalClosD := pGalClosD splitsPts_holds ordEx_holds

theorem galClos_holds : GalClos := pGalClos galClosD_holds

theorem multiSplit_holds : MultiSplit := pMultiSplit fEtBasic_holds splitsBasic_holds galClosD_holds

theorem algIsoPts_holds : AlgIsoPts := pAlgIsoPts _root_.UpperTheory.Gal.G3.pIsoPts

theorem algSplit_holds : AlgSplit := @pAlgSplit @algIsoPts_holds

theorem hodgeFun_holds : ∀ (k : Type) [Field k] {Z Y W : Scheme.{0}} (p : Z ⟶ sp k) (q : Y ⟶ sp k) (r : W ⟶ sp k) (s : Y ⟶ Z) [IsFinite s] [Etale s] (c : W ⟶ Z) (J : Type) [Fintype J] (σ : J → (W ⟶ Y)) (hσ : ∀ j, σ j ≫ s = c), Splits s c σ → ∀ (U : Z.Opens) (hU : IsAffineOpen U) (b : GlobalTheory.CechDR.Sec q (s ⁻¹ᵁ U)), GlobalTheory.HodgeCoh.appSec p r c U (secTrace p q hU b) = ∑ j, GlobalTheory.CechDR.Sec.res r (GlobalTheory.GalTrace.preimage_le (hσ j) U) (GlobalTheory.HodgeCoh.appSec q r (σ j) (s ⁻¹ᵁ U) b) := pHodgeFun _root_.UpperTheory.Gal.G3.pPtsOfSplits algSplit_holds _root_.UpperTheory.Gal.G3.pAlgTr

theorem hodgeTr_holds : HodgeTr := @pHodgeTr @hodgeFun_holds

theorem hodgeGood_holds : HodgeGood := @pHodgeGood @hodgeTr_holds @_root_.UpperTheory.Gal.G3.pHodgeInj

theorem etnGood_holds : EtnGood := @pEtnGood @fEtBasic_holds @_root_.UpperTheory.Gal.G3.pEtTr

theorem etGood_holds : EtGood := @pEtGood @etnGood_holds

theorem bcGood_holds : BcGood.{u} := pBcGood bcSplits_holds bcGal_holds

theorem extGood_holds : ExtGood.{u} := pExtGood _root_.UpperTheory.Gal.G3.pExtTr

theorem opEx_holds : OpEx.{u} := pOpEx _root_.UpperTheory.Gal.G3.pOpTr

alias galInv_holds := _root_.UpperTheory.Gal.G3.pGalInv

theorem opBc_holds : OpBc.{u} := pOpBc bcSplits_holds bcGal_holds

theorem fEtInj_holds : FEtInj.{u} := pFEtInj galClosD_holds

theorem trBase_holds : TrBase.{u} := pTrBase fEtBasic_holds splitsBasic_holds galClosD_holds

theorem trPushM_holds : TrPushM.{u} := pTrPushM fEtBasic_holds splitsBasic_holds splitsComp_holds multiSplit_holds fEtInj_holds

theorem liesAbs_holds : LiesAbs.{u} := pLiesAbs fEtBasic_holds trBase_holds trPushM_holds

theorem hopSpec_holds : HopSpec := pHopSpec etGood_holds bcGood_holds galClos_holds opEx_holds _root_.UpperTheory.Gal.G3.pOpTr _root_.UpperTheory.Gal.G3.pOpEt opBc_holds bcSplits_holds

theorem liesOp_holds : LiesOp.{u} := pLiesOp _root_.UpperTheory.Gal.G3.pLiesGen liesAbs_holds

theorem coverInv_holds : CoverInv.{u} := pCoverInv galInv_holds splitsPts_holds

theorem pieceLe_holds : PieceLe := pPieceLe etGood_holds bcGood_holds extGood_holds _root_.UpperTheory.Gal.G3.pExtTr hopSpec_holds coverInv_holds

theorem twSplit_holds : TwSplit := pTwSplit splitsPts_holds

theorem twGal_holds : TwGal := pTwGal twSplit_holds

end UpperTheory.Gal.G3
