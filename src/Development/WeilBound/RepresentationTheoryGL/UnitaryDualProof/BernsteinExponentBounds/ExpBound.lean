  simp only [Complex.add_re, Complex.sub_re, Complex.re_sum, Complex.conj_re] at h0
  linarith

theorem isLat_sup {m : ℕ} {A A' : AddSubgroup (Fin (m + 1) → k)} (hA : IsLat A) (hA' : IsLat A') : IsLat (A ⊔ A') := by
