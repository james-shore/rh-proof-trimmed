theorem lvl_all (hS : StepForm k) (hsm : IsSmooth π) (B : V →ₗ[ℂ] V →ₗ⋆[ℂ] ℂ)
    (hh : ∀ v w, B w v = starRingEnd ℂ (B v w)) (hp : ∀ v, v ≠ 0 → 0 < (B v v).re)
    (hi : ∀ g v w, B (π g v) (π g w) = B v w) :
    ∀ d m (hm : m + 1 ≤ N), m + 1 + d = N → ∃ B', Lvl ψ π m hm B' := by
