        have hb := hpsd.2 (π (aDiag k N m₂ (z ^ i)) v)
        calc _ ≤ (nabs k z ^ (i * m₂ * (N - m₂ - 1)))⁻¹ * (C * (B (π (aDiag k N m₂ (z ^ i)) v)
