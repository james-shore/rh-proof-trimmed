  have e3 : B v S = ∑ i ∈ Finset.range I, starRingEnd ℂ (B (u i) (u i)) := by

    rw [hS, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hB.1 (u i) v, hself i]
  have e4 : B S S = ∑ i ∈ Finset.range I, B (u i) (u i) := by
    rw [hS]

