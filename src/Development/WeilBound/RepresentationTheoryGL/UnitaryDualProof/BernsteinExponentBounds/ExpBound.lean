    have hApp : ∑ a, (Fin.append (fun _ : Fin 1 => x j) (x ∘ j.succAbove) a).1 =
        (x j).1 + ∑ a, ((x ∘ j.succAbove) a).1 := by
      rw [Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right]
      rw [hy]
    have hsumPerm : ∑ a, ((x ∘ firstPerm j) a).1 = ∑ a, (x a).1 :=
