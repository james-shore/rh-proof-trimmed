          _ ≤ (nabs k z ^ (i * m₂ * (N - m₂ - 1)))⁻¹ * (max C 0 * (B (π (aDiag k N m₂ (z ^ i)) v)
                (π (aDiag k N m₂ (z ^ i)) v)).re) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (le_max_left _ _) hb) hw
