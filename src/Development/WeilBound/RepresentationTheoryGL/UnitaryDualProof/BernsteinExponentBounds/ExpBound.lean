theorem unipB_le_derUnip_one (N : ℕ) : unipB k (Fin N) ≤ derUnip k N 1 := by
  intro g hg
  refine ⟨hg, fun c hc => ?_⟩
  obtain ⟨h1, h2⟩ := (mem_unipB k).1 hg
  have hc0 : (c : ℕ) = 0 := by omega
