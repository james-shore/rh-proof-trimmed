  by_cases hi : (i : ℕ) < n
  · by_cases hj : (j : ℕ) < n
    · simp [hi, hj, show (i : ℕ) < m by omega, show (j : ℕ) < m by omega, mul_comm]
    · simp [hi, hj]
  · by_cases e : i = j
